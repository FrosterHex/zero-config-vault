# Server-only configuration for the Next.js backend-for-frontend.
# Copy to .env.local and replace every value. None of these are exposed to the browser.

# Base URL of the Spring Boot vault API.
VAULT_API_URL=http://localhost:8080

# API keys the server attaches to proxied requests.
# The values below are DEV ONLY (they match the seeded development keys); never use them in production.
VAULT_GUEST_READ_KEY=sk-dev-guest-read
VAULT_GUEST_SANDBOX_KEY=sk-dev-guest-sandbox
VAULT_ADMIN_KEY=sk-dev-key-001

# Admin login password. DEV ONLY value; change it in production.
ADMIN_PASSWORD=admin

# HMAC secret for session cookies: at least 64 hex characters. DEV ONLY value; generate your own
# with: openssl rand -hex 32
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
